{
  "name": "lukaszjagiello-com",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio website for \u0141ukasz Jagie\u0142\u0142o Photography (lukaszjagiello.com).",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-photo-manifest.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-sitemap.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "placeholders": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-placeholders.mjs",
    "thumbs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-thumbs.mjs",
    "fulls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-fulls.mjs",
    "hero": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-hero.mjs",
    "og": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-og.mjs",
    "sitemap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-sitemap.mjs",
    "manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-photo-manifest.mjs",
    "downloads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-downloads.mjs",
    "encrypt-downloads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/encrypt-downloads.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
