# Copy to .env.local for local development. On Render these are set in render.yaml
# (or the dashboard). NEXT_PUBLIC_* values are baked in at BUILD time — redeploy
# after changing them.

# Canonical origin used for canonical tags, Open Graph, JSON-LD, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://lukaszjagiello.com

# Show the gallery location filter bar (already implemented, off by default).
NEXT_PUBLIC_GALLERY_FILTERS=false

# Contact form delivery (not wired yet — see pages/api/contact.js -> deliver()).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@lukaszjagiello.com

# Unlocks private/downloads/*/*.jpg.enc. 32 bytes, base64. Server only.
# Downloads return 503 until this is set. Never commit the value.
# DOWNLOAD_FILES_KEY=
